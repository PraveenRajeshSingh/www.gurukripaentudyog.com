# Root-level development placeholders for Maps / payments / kiln HQ.
# Copy to .env for local static PWA tooling. Never commit real secrets.
# Backend secrets live in backend/.env — see backend/.env.example.
# Next.js secrets live in apps/web/.env.local — see apps/web/.env.example.

NODE_ENV=development
PORT=8080

GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY_HERE
GOOGLE_MAPS_SERVER_KEY=YOUR_GOOGLE_MAPS_SERVER_KEY_HERE

# Leave blank in this example. Set test-mode keys in local .env only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

BHATTA_HQ_NAME="Gurukripa Bricks Kiln Unit 1"
BHATTA_LAT=25.7476
BHATTA_LNG=82.6837
DELIVERY_MAX_RADIUS_KM=120
DELIVERY_BASE_RATE_PER_KM=25

WHATSAPP_BUSINESS_PHONE=919198923230
SUPPORT_EMAIL=info@gurukripaentudyog.com
