# Next.js storefront (apps/web) — server-only secrets.
# Copy to apps/web/.env.local for local development. Never commit real values.

# NestJS platform API base URL (no trailing slash).
# Used only by server-side proxies under src/app/api/*.
# If unset, login / me / enquiry proxies return HTTP 503 with a clear message.
BACKEND_API_URL=http://127.0.0.1:3000

# Optional analytics id. Leave empty to keep consent/analytics UI dormant.
# NEXT_PUBLIC_ANALYTICS_ID=

# Public site URL used for absolute links in metadata (optional override).
# NEXT_PUBLIC_SITE_URL=https://www.gurukripaentudyog.com
