# Production placeholders — copy values into your host secrets manager / CI secrets.
# Never commit real passwords, JWT secrets, payment keys, or signing material.
# Leave payment and map keys blank here; inject them only at deploy time.

NODE_ENV=production
PORT=8080

# Maps (Google Cloud — restrict keys by HTTP referrer / IP)
# Set real values only in the deployment environment — leave blank here.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Payments (Razorpay) — inject keys via secrets manager at deploy time.
# Never commit live or test key strings into this repository.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

BHATTA_HQ_NAME="Gurukripa Bricks Kiln Unit 1"
BHATTA_LAT=25.7476
BHATTA_LNG=82.6837
DELIVERY_MAX_RADIUS_KM=120
DELIVERY_BASE_RATE_PER_KM=25

WHATSAPP_BUSINESS_PHONE=919198923230
SUPPORT_EMAIL=info@gurukripaentudyog.com

# Docker Compose / NestJS (set separately from this file in production)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=brick_supply_saas
# DATABASE_URL=
# JWT_SECRET=
# CORS_ORIGINS=https://www.gurukripaentudyog.com,https://gurukripaentudyog.com
