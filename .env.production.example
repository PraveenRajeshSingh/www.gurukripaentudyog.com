# Production placeholders — set these in your host secrets manager / CI secrets.
# Never commit real passwords, JWT secrets, payment keys, or signing material.

NODE_ENV=production
PORT=8080

# Maps (Google Cloud — restrict keys by HTTP referrer / IP)
GOOGLE_MAPS_API_KEY=YOUR_PRODUCTION_BROWSER_KEY
GOOGLE_MAPS_SERVER_KEY=YOUR_PRODUCTION_SERVER_KEY

# Payments (Razorpay live keys only after test mode validation)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_WEBHOOK_SECRET

BHATTA_HQ_NAME="Gurukripa Bricks Kiln Unit 1"
BHATTA_LAT=25.7476
BHATTA_LNG=82.6837
DELIVERY_MAX_RADIUS_KM=120
DELIVERY_BASE_RATE_PER_KM=25

WHATSAPP_BUSINESS_PHONE=919198923230
SUPPORT_EMAIL=info@gurukripaentudyog.com

# Docker Compose / NestJS (set separately from this file in production)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=brick_supply_saas
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/brick_supply_saas?sslmode=require
