{
  "name": "brick-saas-backend",
  "version": "1.0.0",
  "description": "Enterprise Multi-Tenant Brick Supply ERP & SaaS API Backend",
  "scripts": {
    "build": "tsc && node scripts/copy-sql.js",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node src/main.ts",
    "migrate": "node dist/src/database/migrator.js",
    "smoke": "node scripts/smoke.js",
    "seed:demo": "ts-node scripts/seed-demo-accounts.ts",
    "seed:demo:reset": "ts-node scripts/seed-demo-accounts.ts --reset",
    "test": "node --test test/isolation_and_pricing.test.js test/pricing_idempotency.test.js dist/test/backend.test.js dist/test/platform.test.js dist/test/demo_accounts.test.js",
    "test:demo-accounts": "node --test dist/test/demo_accounts.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "typescript": "^5.3.3"
  }
}
