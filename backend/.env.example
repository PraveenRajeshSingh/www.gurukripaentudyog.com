# Local Development Database Configuration
# DO NOT commit real secrets to Git
PORT=3000
NODE_ENV=development

# Local PostgreSQL Configuration (Set your local credentials or staging server)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=local_dev_password
DB_NAME=brick_supply_saas_dev
DATABASE_URL=postgresql://postgres:local_dev_password@127.0.0.1:5432/brick_supply_saas_dev

# JWT Secret for Local Development
JWT_SECRET=local_dev_super_secret_jwt_key_not_for_prod_2026
JWT_EXPIRATION=12h

# CORS allow-list (comma separated). Add the Capacitor app origin when testing
# native builds, e.g. https://localhost (androidScheme: https) and the web app URL.
CORS_ORIGINS=http://localhost:8080,https://www.gurukripaentudyog.com

# Bootstrap administrator (optional). Created on first boot ONLY if no ADMIN
# exists. Remove these after the admin account is set up.
# BOOTSTRAP_ADMIN_PHONE=9876543210
# BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# Push notification transport (requirement E). Leave unset to disable outbound
# push - the in-app notification inbox still works. Point at a Cloud Function
# / relay that holds the Firebase Cloud Messaging v1 credentials; the app and
# this backend never embed a server key.
# PUSH_WEBHOOK_URL=https://your-relay.example.com/push
# PUSH_WEBHOOK_TOKEN=shared-secret-for-the-relay

# Payment gateway (requires merchant account details before live charging):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Google reCAPTCHA v3 (optional). When SECRET is set, login/register/guest enquiry require captchaToken.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
