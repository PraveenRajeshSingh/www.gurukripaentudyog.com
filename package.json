{
  "name": "gurukripa-bricks-industry",
  "version": "4.2.0",
  "private": true,
  "description": "Gurukripa Ent Udyog enterprise monorepo — Next.js web client (apps/web), native Kotlin/Compose Android client (apps/android), shared API contracts (packages/api-contracts), NestJS platform backend (backend) and the legacy static PWA storefront at the repository root (GitHub Pages, Capacitor shells).",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/",
    "test:contracts": "node --test packages/api-contracts/test/contracts.test.js",
    "test:web": "node --test apps/web/tests/web.test.js",
    "test:backend": "npm --prefix backend run build && npm --prefix backend test",
    "test:all": "npm run test:contracts && npm run test:web && npm test",
    "check": "npm run test && npm run www",
    "build": "node scripts/build.js",
    "build:contracts": "npm run build --workspace @gurukripa/api-contracts",
    "dev:web": "npm run dev --workspace @gurukripa/web",
    "build:web": "npm run build --workspace @gurukripa/web",
    "start:web": "npm run start --workspace @gurukripa/web",
    "www": "npm run build && node scripts/prepare-www.js",
    "serve": "npm run build && http-server . -p 8080 -c-1",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "sync": "npm run www && cap sync",
    "android": "npm run www && cap sync android && cap open android",
    "ios": "npm run www && cap sync ios && cap open ios",
    "doctor": "cap doctor",
    "assetlinks": "node scripts/assetlinks.js",
    "twa:doctor": "bubblewrap doctor",
    "twa:init": "bubblewrap init --manifest https://www.gurukripaentudyog.com/manifest.json",
    "twa:build": "bubblewrap build --skipTwaValidation --skipPlayStorage"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.27.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "follow-redirects": "^1.16.2",
    "http-server": "^14.1.1"
  }
}
