<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config — Gurukripa Bricks Industry
    Enforces HTTPS for all connections. Allows cleartext only to localhost for
    Capacitor live-reload during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow Capacitor dev server on localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
