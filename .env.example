# ═════════════════════════════════════════════════════════════════
# GURUKRIPA BRICKS INDUSTRY — PRODUCTION INTEGRATION ENVIRONMENT
# ═════════════════════════════════════════════════════════════════

# Node Environment
NODE_ENV=production
PORT=8080

# ── 1. Google Maps Platform Credentials ─────────────────────────
# Obtain from Google Cloud Console: https://console.cloud.google.com/
# Required APIs enabled: Maps JavaScript API, Places API (New), Geocoding API, Routes API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY_HERE
GOOGLE_MAPS_SERVER_KEY=YOUR_GOOGLE_MAPS_SERVER_KEY_HERE

# ── 2. Razorpay Payment Gateway (India Standard) ─────────────────
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# Start with test mode keys (rzp_test_...) before deploying live (rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_FOR_SIGNATURE_VERIFICATION

# ── 3. Bhatta Base Station Coordinates (Kiln Dispatch HQ) ────────
BHATTA_HQ_NAME="Gurukripa Bricks Kiln Unit 1"
BHATTA_LAT=25.7476
BHATTA_LNG=82.6837
DELIVERY_MAX_RADIUS_KM=120
DELIVERY_BASE_RATE_PER_KM=25

# ── 4. Notifications & Communication ─────────────────────────────
WHATSAPP_BUSINESS_PHONE=919198923230
SUPPORT_EMAIL=info@gurukripaentudyog.com
